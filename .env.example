# Copy to .env for local development. NEVER commit the real .env file.
PORT=8080

# Free key: https://console.groq.com/keys
# Without it the app still works and serves curated fallback ideas instead of AI-generated ones.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Per-request time limit for AI answers (milliseconds, max 60000).
AI_TIMEOUT_MS=30000
RATE_LIMIT_PER_MIN=60
AI_RATE_LIMIT_PER_MIN=10
